{
  "seed": 21,
  "rules": [
    {
      "name": "truncated-order-response",
      "match": { "method": "POST", "path_prefix": "/v2/checkout/orders" },
      "fault": "truncate_after_commit",
      "probability": 0.2
    },
    {
      "name": "lost-response-on-order",
      "match": { "method": "POST", "path_prefix": "/v2/checkout/orders" },
      "fault": "drop_after_commit",
      "probability": 0.1
    },
    {
      "name": "slow-network",
      "fault": "latency",
      "probability": 0.2,
      "delay_ms": 300
    }
  ],
  "webhooks": { "duplicate_probability": 0, "duplicate_count": 0, "max_delay_ms": 0, "reorder_window_ms": 0 },
  "operation_id": ["purchase_units.0.invoice_id"],
  "min_backoff_ms": 200
}
